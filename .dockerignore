# 版本控制与编辑器
.git
.gitignore
.claude
.vscode
.idea
.DS_Store

# 密钥 —— 绝不进镜像（容器内改用 docker-compose 的 environment 注入）
.env

# Python 产物
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# 运行时数据
data/
*.sqlite3
*.db

# 前端依赖与产物（由 frontend/Dockerfile 单独构建）
frontend/node_modules/
frontend/dist/

# 镜像里用不到的开发资料
docs/
tests/
scripts/
