# ========= 复制为 .env 并填写真实值 =========
# 默认即 mock（无需 key，离线可跑通全链路）。
# 使用真实模型时改为 dashscope 或 zhipu，并填写对应 API Key。

# 模型供应商：dashscope | zhipu | mock
RAG_PROVIDER=dashscope

# DashScope（阿里云百炼 / 通义千问）—— https://help.aliyun.com/zh/model-studio
# 控制台获取：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
LLM_MODEL=qwen-plus

# 智谱 GLM —— https://open.bigmodel.cn/
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 覆盖上面两个变量时使用：
# EMBEDDING_MODEL=embedding-3
# LLM_MODEL=glm-4-flash

# ========= 鉴权 =========
# ⚠️ 生产部署务必使用随机字符串（例如 openssl rand -hex 32）
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=24
EMBEDDING_DIM=1024        # text-embedding-v3 默认 1024；embedding-3 为 2048 时改这里
CHUNK_SIZE=800            # 切块字符数
CHUNK_OVERLAP=120         # 相邻块重叠字符数
CHUNK_STRATEGY=fixed      # 切块策略（H2 语义切分）：fixed（定长递归）| structure（结构优先语义切分，离线免费）| structure+semantic（结构+句级 embedding 微调，需真实 embedding）
SEMANTIC_BREAK_THRESHOLD=0.65  # structure+semantic 用：句间余弦相似度低于此值视为主题断层
TOP_K=5                   # 检索返回块数
VECTOR_STORE=chroma       # chroma | pgvector（pgvector 需先配好下方 PostgreSQL）
RETRIEVAL_MODE=hybrid     # 检索模式：vector（纯向量）| hybrid（向量+关键词全文融合，H1）
RERANK=false              # 重排（I1）：true 启用——检索后按重排模型/词重叠重排候选，替换检索分；默认 false（排序与分数完全不变）
RERANK_MODEL=gte-rerank   # 真实重排模型（DashScope gte-rerank，走 {base_url}/rerank）
DATA_DIR=data             # 本地持久化目录（ChromaDB 模式）

# ========= PostgreSQL（VECTOR_STORE=pgvector 时必填）=========
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=              # ⚠️ 替换为你的 postgres 密码，不要提交到 Git
PG_DATABASE=ragdb
