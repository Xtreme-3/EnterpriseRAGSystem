# ========= 复制为 .env 并填写真实值 =========
# 默认即 mock（无需 key，离线可跑通全链路）。
# 使用真实模型时改为 dashscope / bailian / zhipu，并填写对应 API Key。

# 模型供应商：dashscope（=第三方中转站槽位）| bailian（=阿里云百炼官方）| zhipu | mock
RAG_PROVIDER=dashscope

# ---- DashScope 槽位：本项目历史指向第三方中转站（如 tokenrhythm.studio）----
# key 与 base_url 必须配套：换供应商时两个一起改。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://tokenrhythm.studio/v1
LLM_MODEL=qwen3.8-flash

# ---- 阿里云百炼官方（Model Studio）----
# 控制台：https://bailian.console.aliyun.com/   开通即送各模型 100 万 token（90 天有效）
# 仅华北2（北京）地域有免费额度，compatible-mode 默认端点即北京。
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 覆盖上面模型名时使用（属 Qwen3-Embedding 系，默认 1024 维）：
# EMBEDDING_MODEL=qwen3.7-text-embedding

# ---- 智谱 GLM —— https://open.bigmodel.cn/ ----
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_MODEL=embedding-3      # 2048 维
# LLM_MODEL=glm-4-flash

# ---- 插槽级覆盖（留空 = 跟随 RAG_PROVIDER）----
# 三个插槽可分别指向不同供应商，典型组合：LLM 走中转站 + Embedding 走百炼官方。
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=text-embedding-v3
LLM_PROVIDER=
RERANK_PROVIDER=

# ========= 鉴权 =========
# ⚠️ 生产部署务必使用随机字符串（例如 openssl rand -hex 32）
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=24

# ========= 日志（K8）=========
# 级别：DEBUG | INFO | WARNING | ERROR | CRITICAL（配错的名字会在启动时直接报错）
# 改成 DEBUG 才能看到：「检索被阈值筛除了几条」「重排结果是否完整」「查询改写是否降级」——
# 这几类问题在 INFO 下是完全静默的。
# 日志走 stderr（容器里交给 docker 日志驱动收集），每行带 request_id，便于按请求追溯。
LOG_LEVEL=INFO
EMBEDDING_DIM=1024        # 必须与模型实际返回维度一致（v3/v4/qwen3.7-text-embedding 均为 1024；embedding-3 为 2048）
                          # ⚠️ 换维度后原向量集合不可再用，必须重建集合并重新导入文档
CHUNK_SIZE=800            # 切块字符数
CHUNK_OVERLAP=120         # 相邻块重叠字符数
CHUNK_STRATEGY=structure  # 切块策略（H2 语义切分）：fixed（定长递归，块内**不含**章节标题）| structure（结构优先语义切分，标题落在块首，模型才能引「4.2 节」）| structure+semantic（结构+句级 embedding 微调，需真实 embedding）
SEMANTIC_BREAK_THRESHOLD=0.65  # structure+semantic 用：句间余弦相似度低于此值视为主题断层
TOP_K=5                   # 检索返回块数
VECTOR_STORE=chroma       # chroma | pgvector（pgvector 需先配好下方 PostgreSQL）
RETRIEVAL_MODE=hybrid     # 检索模式：vector（纯向量）| hybrid（向量+关键词全文融合，H1）
RERANK=false              # 重排（I1）：true 启用——检索后按重排模型/词重叠重排候选，替换检索分；默认 false（排序与分数完全不变）
RERANK_MODEL=gte-rerank-v2  # 真实重排模型；百炼走原生端点（{站点根}/api/v1/services/rerank/...），实测可用：gte-rerank-v2 / qwen3-rerank
DATA_DIR=data             # 本地持久化目录（ChromaDB 模式）

# ========= 生成参数（K3）=========
# ⚠️ LLM_MAX_TOKENS 是**含推理 token** 的总预算：qwen3.8-flash 这类推理模型的
# reasoning_tokens 也算在里面（实测一问就吃 900–2000）。给 1024 时正文会被截在句子
# 中间甚至为空（finish_reason=length，HTTP 却仍是 200）。故默认 2048。
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
# 推理开关：留空 = 不下发该字段（兼容任意供应商）；true / false = 显式下发 enable_thinking。
# 实测同一问题 开思考 17.9s / 关思考 6.3s，且关思考后正文更完整（预算没被思维链吃掉）。
# 演示与压测建议 false；追求复杂推理可留空或 true。
LLM_ENABLE_THINKING=false

# ========= PostgreSQL（VECTOR_STORE=pgvector 时必填）=========
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=              # ⚠️ 替换为你的 postgres 密码，不要提交到 Git
PG_DATABASE=ragdb
